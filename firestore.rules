rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /placements/{placementId} {
      allow read: if true;
      // Board members can do everything
      allow create, delete: if request.auth != null;
      // Board members can update anything.
      // Students (unauthenticated) can ONLY update the 'signUps' field.
      allow update: if request.auth != null || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signUps']));
    }
    match /notifications/{notificationId} {
      allow read: if true;
      // Only board members create notifications (when reducing capacity)
      allow write: if request.auth != null;
    }
  }
}
